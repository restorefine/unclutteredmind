# Uncluttered Mind — configuration
# Copy to .env and fill in. Never commit .env. Every value is optional unless marked REQUIRED.

# ---------------------------------------------------------------- server
PORT=3000
# Timezone the planner thinks in. Reminders fire in this timezone.
TZ=Europe/London
# Where the database (unclutteredmind.db) and daily backups live. Must be a persistent disk in production.
DATA_DIR=./data
# Set to 1 when running behind a reverse proxy / platform load balancer (Caddy, Nginx, Render, Railway…)
TRUST_PROXY=0
# Domain used by docker-compose.standalone.yml + Caddy for automatic HTTPS (fresh VPS only)
DOMAIN=app.example.com
# Cloudflare Tunnel token, used by docker-compose.yml (server that already runs something on 80/443).
# Cloudflare Zero Trust > Networks > Tunnels > Create tunnel > Cloudflared > copy the token.
TUNNEL_TOKEN=

# ---------------------------------------------------------------- security
# REQUIRED before going online (the app refuses to start in production without them).
# The one account that can sign in. After the first password login the app offers to set up
# Face ID / Touch ID / fingerprint (a passkey), so you rarely type the password again.
APP_USERNAME=
# Use 12+ characters. Changing it signs every device out (passkeys keep working).
APP_PASSWORD=
# Recommended in production: the exact address people open, e.g. https://app.example.com
# Passkeys are tied to this address. If empty, it is taken from each request.
APP_ORIGIN=
# Optional. Signs login cookies. If empty, a random secret is generated and stored in the database.
SESSION_SECRET=
# Force the Secure flag on cookies (automatic when TRUST_PROXY=1 and the proxy says https).
COOKIE_SECURE=0

# ---------------------------------------------------------------- WhatsApp Cloud API (business number)
# REQUIRED for WhatsApp. Permanent System User token with whatsapp_business_messaging + whatsapp_business_management.
WA_TOKEN=
# REQUIRED for WhatsApp. "Phone number ID" of the business number (WhatsApp > API Setup).
WA_PHONE_NUMBER_ID=
# REQUIRED for WhatsApp. The personal number that receives reminders, with country code, e.g. 447700900123.
WA_TO=
# REQUIRED for replies. Any long random string; paste the same value into Meta's webhook settings.
WA_VERIFY_TOKEN=
# REQUIRED in production. Meta app secret (App settings > Basic). Rejects forged webhook calls.
WA_APP_SECRET=
# REQUIRED for reminders outside the 24h window. Approved Utility template with one body variable {{1}}.
WA_TEMPLATE_NAME=unclutteredmind_reminder
# Optional. Approved template with one body variable and three quick-reply buttons: Done, +15 min, Tomorrow (in that order).
WA_TEMPLATE_BUTTONS_NAME=
WA_TEMPLATE_LANG=en_GB
WA_API_VERSION=v21.0

# ---------------------------------------------------------------- AI (optional)
# Understanding messy brain dumps + "Break it into small steps". Anthropic is used if set, else OpenAI.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# OpenAI: needed for voice notes (WhatsApp + in-app recording). Also used for brain dumps if no Anthropic key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TRANSCRIBE_MODEL=whisper-1
AI_TIMEOUT_MS=20000
